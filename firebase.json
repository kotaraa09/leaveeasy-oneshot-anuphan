{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "leaveeasy-oneshot-anuphan",
    "public": ".",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "**/*.md",
      "js/ai-key.example.js",
      "playwright.config.js",
      "tests/**",
      "test-results/**",
      "seed.html",
      "js/seed.js"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
